@model Library.Entities.Category
@{
    ViewData["Title"] = "ایجاد دسته‌بندی";
}

<div class="page-intro">
    <div>
        <a asp-action="Index" class="back-link">← بازگشت به دسته‌بندی‌ها</a>
        <p class="eyebrow mt-4">سازمان‌دهی مجموعه</p>
        <h2 class="page-heading">دسته‌بندی تازه بسازید</h2>
        <p class="page-subtitle">موضوع‌های کتابخانه را تعریف کنید تا پیدا کردن کتاب‌ها ساده‌تر شود.</p>
    </div>
    <span class="page-icon category-tone">▦</span>
</div>

<div class="editor-grid category-editor-grid">
    <form asp-action="Create" method="post" class="editor-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-section-heading"><span class="section-number mint-number">۰۱</span><div><h3>مشخصات دسته‌بندی</h3><p>یک نام روشن و توضیح کاربردی انتخاب کنید.</p></div></div>
        <div class="field-group">
            <label asp-for="Title" class="field-label"></label>
            <input asp-for="Title" class="field-input" maxlength="120" placeholder="مثلاً ادبیات کلاسیک" autocomplete="off" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>
        <div class="field-group">
            <label asp-for="Description" class="field-label"></label>
            <textarea asp-for="Description" class="field-input field-textarea" maxlength="800" rows="5" placeholder="این دسته‌بندی شامل چه نوع کتاب‌هایی است؟"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary submit-loading-button" data-loading-button data-loading-text="در حال ایجاد..."><span class="button-label">＋ ایجاد دسته‌بندی</span></button>
            <a asp-action="Index" class="btn-quiet">انصراف</a>
        </div>
    </form>
    <aside class="editor-aside">
        <div class="category-tip-card"><span class="category-tip-icon">▦</span><p class="eyebrow">دسته‌بندی بهتر</p><h3>نام‌ها را ساده و مشخص انتخاب کنید</h3><p>از نام‌های کوتاه و توصیفی استفاده کنید تا دسته‌بندی کتاب‌ها برای همه قابل فهم باشد.</p><div class="suggestion-chips"><span>ادبیات</span><span>تاریخ</span><span>علوم</span><span>کودک و نوجوان</span></div></div>
    </aside>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
